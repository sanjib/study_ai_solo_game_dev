        <rdfs:comment>Is a location in StardewValley, for example: PelicanTown, TheBeach, CinderSapForest, etc. Child of a location is an address.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#lovedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#lovedBy">
