    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#livesIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#livesIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#Place"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#CalicoDesert"/>
