    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#growsInSeason"/>
    


    <!-- http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#hasAddressIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#hasAddressIn">
        <rdfs:comment>Is an address in a location in StardewValley. It has parent a location.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#hasBirthdayInSeason -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#hasBirthdayInSeason">
