                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#Fall"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#hasBirthdayInSeason"/>
