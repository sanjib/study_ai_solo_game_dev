    <!-- http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#likedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sanji/ontologies/2025/10/StardewValley#likedBy">
